# Salin menjadi .env lalu isi nilainya. .env TIDAK PERNAH di-commit.
# Token bot dari @BotFather
BOT_TOKEN=123456789:AAA-your-token-here
# Chat id owner (angka). Bot menolak chat selain owner di MVP.
OWNER_CHAT_ID=0
# PostgreSQL, driver asyncpg
DATABASE_URL=postgresql+asyncpg://polywatch_app:CHANGE_ME@localhost:5432/polywatch_db
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Database khusus integration test (opsional; test di-skip bila tidak ada)
TEST_DATABASE_URL=postgresql+asyncpg://polywatch_app:CHANGE_ME@localhost:5432/polywatch_test
# Health monitor (T-019/T-029) — ambang basi & notifikasi.
# STALE_DISCOVER_S/STALE_RESULT_S = FLOOR; ambang efektif adaptif:
# max(3x durasi siklus terukur, floor).
STALE_INGEST_S=600
STALE_DISCOVER_S=300
STALE_RESULT_S=300
HEALTH_RATE_LIMIT_S=600
HEALTH_GRACE_S=300
HEALTH_CHECK_INTERVAL_S=30
# Scheduler (T-029/ADR-016) — interval & batas kerja per siklus
DISCOVER_INTERVAL_S=60
RESULT_INTERVAL_S=60
# Konkurensi maksimum request Gamma per siklus discover (semaphore)
GAMMA_MAX_CONCURRENCY=5
# Maksimum market CLOSED diproses record_result + sweep per siklus
RESULT_BATCH_SIZE=10
# State notifikasi health persisten antar-restart (default: temp dir)
# HEALTH_STATE_FILE=/tmp/polywatch-health-state.json
# Single-instance lock (default: temp dir)
# LOCK_FILE=/tmp/polywatch.lock
