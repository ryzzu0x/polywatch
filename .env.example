# Salin menjadi .env lalu isi nilainya. .env TIDAK PERNAH di-commit.
# Token bot dari @BotFather
BOT_TOKEN=123456789:AAA-your-token-here
# Chat id owner (angka). Bot menolak chat selain owner di MVP.
OWNER_CHAT_ID=0
# PostgreSQL, driver asyncpg
DATABASE_URL=postgresql+asyncpg://polywatch_app:CHANGE_ME@localhost:5432/polywatch_db
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Database khusus integration test (opsional; test di-skip bila tidak ada)
TEST_DATABASE_URL=postgresql+asyncpg://polywatch_app:CHANGE_ME@localhost:5432/polywatch_test
